pipeline{
    agent any
    environment{
        SONAR_HOST_URL = "http://65.1.43.152:9000/"
        IMAGE = "generic-app"
        TAG = "local"
    }
    stages{
        stage('Enviornment'){
            steps{
                echo "Setting up Local environment for python."
                echo "======================================="

                sh 'python3 --version'
                
                echo "Creating Virtual environment."
                echo "======================================="

                sh 'python3 -m venv .venv'
            }
        }
        stage('Initial'){
            steps{
                echo "Upgrading pip version with latest and Installing python."
                echo "======================================="

                sh '''
                .venv/bin/python -m pip install --upgrade pip
                .venv/bin/python -m pip install -r requirements-jenkins.txt
                .venv/bin/python -m pip install pysonar
                
                echo "Checking package version"
                echo "======================================="
                
                .venv/bin/python -m flask --version
                .venv/bin/python -m coverage --version
                .venv/bin/python -m pytest --version
                .venv/bin/pysonar --version
                '''

                echo "Packages installed successfully"
            }
        }
        stage('Testing'){
            steps{
                echo "Unit Testing and Code coverage(coverage.xml)"
                echo "======================================="

                sh '''
                .venv/bin/python -m pytest --cov=app --cov-report=xml
                .venv/bin/python -m coverage report -m 
                ls -la coverage.xml
                '''
            }
        }
        stage('Sonarqube'){
            steps{
                echo "Sending code coverage report to sonarqube via pysonar for analysis."
                echo "======================================="

                withCredentials([string(credentialsId: 'Sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh '.venv/bin/pysonar'
                }
            }
        }
        stage('Build'){
            steps{
                echo "Building docker image locally"
                echo "======================================="

                sh 'docker build -t "$IMAGE:$TAG" .'
            }
        }
        stage('Deploy'){
            steps{
                echo "Deploying local build image on docker"
                echo "======================================="

                sh 'docker rm --force test-app || true'
                sh 'docker run -d --name test-app -p 5000:5000 "$IMAGE:$TAG"'
                sh 'docker ps -a'
                
                echo "Deployed app container successfully"
            }
        }
        stage('Artifact'){
            steps{
                sh '''
                cat > deploy-info-$BUILD_NUMBER.txt <<EOF
                build: $BUILD_NUMBER
                image: $IMAGE:$TAG
                commit: ${GIT_COMMIT}
                branch: $GIT_BRANCH
                time: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
                url: $BUILD_URL
                EOF
                '''
                archiveArtifacts artifacts: "deploy-info-${BUILD_NUMBER}.txt", fingerprint: true
            }
        }
    }
    post{
        success{echo 'Pipeline Build Successfully.'}
        failure{echo 'Pipeline Failed! Check for error and issued.'}
        always{echo 'Pipleine completed'}
    }
}